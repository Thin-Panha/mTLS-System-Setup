# ---------------------------------------------------------------------------
# provision.env
#
#   cp provision.env.example provision.env
#   chmod 600 provision.env
#
# Read by scripts/create-certificate.sh, scripts/create-database.sh, and
# scripts/encrypt-secrets.sh, as plain text (never executed/sourced).
# Nothing here is installed anywhere as-is; certificate fields become a
# signed cert + key, DB fields provision Postgres, secret fields become
# encrypted systemd-creds .cred files.
#
# NEVER commit this file (with real values) to git. Delete it once both
# scripts have run successfully: shred -u provision.env
# ---------------------------------------------------------------------------

# ---- Used by create-certificate.sh ----------------------------------------

# FQDN this server's TLS certificate will be issued for (must resolve here)
DOMAIN=auth.mpwt.local

# ---- Used by create-database.sh --------------------------------------------

# Postgres connection details. 
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=

# ---- Used by encrypt-secrets.sh --------------------------------------------

# Telegram bot token, from @BotFather (format: 123456789:AA...)
TELEGRAM_BOT_TOKEN=

# Shared API key used by both the bot and the enrollment API
# (leave blank to auto-generate)
MPWT_API_KEY=

# Flask secret key for enrollment-api (leave blank to auto-generate)
SECRET_KEY=

# HMAC key used to sign/verify policy documents (leave blank to auto-generate)
POLICY_HMAC_KEY=

# Database password (required, no auto-generate -- must match your DB user)
DB_PASSWORD=
